#!/bin/sh
# Starts Claude Code with the isolated agentgateway profile.
# With Entra ID sign-in configured, it first opens the Microsoft sign-in page if you
# have no usable sign-in. Installed by scripts/claude-code-profile.sh.
#
#   claude-agw [claude arguments]
#   claude-agw login | logout        Entra ID sign-in only
PROFILE_DIR="$(cd "$(dirname "$0")/.." && pwd)"

if [ -f "$PROFILE_DIR/entra.json" ]; then
  case "${1:-}" in
    login|logout) exec "$PROFILE_DIR/entra-token.py" "$1" ;;
  esac
  "$PROFILE_DIR/entra-token.py" ensure || exit 1
fi

CLAUDE_CONFIG_DIR="$PROFILE_DIR" exec claude "$@"
